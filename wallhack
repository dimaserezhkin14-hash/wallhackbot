<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Quoridor Grandmaster Engine</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg-color: #0b0f19;
      --card-bg: #151d30;
      --accent: #3b82f6;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --p1: #0ea5e9;
      --p2: #f43f5e;
      --wall-placed: #cbd5e1;
      --wall-hint: #22c55e;
    }
    * { box-sizing: border-box; user-select: none; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-color);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 8px;
      touch-action: manipulation;
    }
    .panel {
      width: 100%;
      max-width: 420px;
      background: var(--card-bg);
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 8px;
    }
    .status-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
    }
    .turn-badge {
      padding: 4px 10px;
      border-radius: 6px;
      color: #fff;
      font-size: 12px;
    }
    .p1-turn { background: var(--p1); }
    .p2-turn { background: var(--p2); }
    .controls {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-top: 10px;
    }
    button {
      background: #243049;
      color: #fff;
      border: 1px solid rgba(255,255,255,0.08);
      padding: 8px 4px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    button.active { background: var(--accent); border-color: #60a5fa; }
    .calc-btn {
      grid-column: span 3;
      background: #16a34a;
      font-size: 14px;
      padding: 10px;
      font-weight: 700;
      border: none;
    }
    #board-container {
      width: 100%;
      max-width: 420px;
      aspect-ratio: 1;
      background: #090d16;
      padding: 6px;
      border-radius: 12px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.6);
    }
    #board {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: repeat(9, 1fr 6px) 1fr;
      grid-template-rows: repeat(9, 1fr 6px) 1fr;
    }
    .cell {
      background: #1b2438;
      border-radius: 4px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .cell.hint-move {
      background: #065f46;
      border: 2px solid #34d399;
    }
    .pawn {
      width: 70%;
      height: 70%;
      border-radius: 50%;
      box-shadow: 0 2px 6px rgba(0,0,0,0.8);
    }
    .p1-pawn { background: var(--p1); }
    .p2-pawn { background: var(--p2); }
    .slot-v {
      background: rgba(255, 255, 255, 0.03);
      cursor: pointer;
    }
    .slot-h {
      background: rgba(255, 255, 255, 0.03);
      cursor: pointer;
    }
    .slot-dot { background: transparent; }
    .wall-active { background: var(--wall-placed) !important; border-radius: 2px; }
    .wall-hint { background: var(--wall-hint) !important; border-radius: 2px; box-shadow: 0 0 8px #22c55e; }
    .eval-box {
      font-size: 12px;
      margin-top: 8px;
      text-align: center;
      color: var(--text-muted);
      font-weight: 500;
    }
  </style>
</head>
<body>

  <div class="panel">
    <div class="status-row">
      <div>Вы (Низ): <b style="color:var(--p1)"><span id="p1-walls">10</span></b></div>
      <div id="turn-indicator" class="turn-badge p1-turn">Ход: Вы</div>
      <div>Враг (Верх): <b style="color:var(--p2)"><span id="p2-walls">10</span></b></div>
    </div>
    <div class="controls">
      <button id="btn-mode-move" class="active" onclick="setMode('move')">Ход фишки</button>
      <button id="btn-mode-hwall" onclick="setMode('hwall')">Стена Гориз.</button>
      <button id="btn-mode-vwall" onclick="setMode('vwall')">Стена Верт.</button>
      <button class="calc-btn" onclick="calculateBestMove()">⚡ Рассчитать лучший ход</button>
      <button onclick="switchTurn()">Очередность</button>
      <button onclick="undoMove()">Шаг назад</button>
      <button onclick="resetGame()">Сброс</button>
    </div>
    <div id="eval-info" class="eval-box">Дистанция: Вы 8 | Враг 8</div>
  </div>

  <div id="board-container">
    <div id="board"></div>
  </div>

<script>
  if (window.Telegram?.WebApp) {
    window.Telegram.WebApp.ready();
    window.Telegram.WebApp.expand();
  }

  let state = {
    turn: 1,
    p1: { r: 8, c: 4, walls: 10 },
    p2: { r: 0, c: 4, walls: 10 },
    hWalls: Array(8).fill(0).map(() => Array(8).fill(false)),
    vWalls: Array(8).fill(0).map(() => Array(8).fill(false)),
  };

  let editMode = 'move';
  let history = [];
  let bestAction = null;

  function setMode(m) {
    editMode = m;
    document.querySelectorAll('.controls button').forEach(b => b.classList.remove('active'));
    document.getElementById(`btn-mode-${m}`)?.classList.add('active');
  }

  function saveHistory() {
    history.push(JSON.parse(JSON.stringify(state)));
  }

  function undoMove() {
    if (history.length > 0) {
      state = history.pop();
      bestAction = null;
      render();
    }
  }

  function resetGame() {
    state = {
      turn: 1,
      p1: { r: 8, c: 4, walls: 10 },
      p2: { r: 0, c: 4, walls: 10 },
      hWalls: Array(8).fill(0).map(() => Array(8).fill(false)),
      vWalls: Array(8).fill(0).map(() => Array(8).fill(false)),
    };
    bestAction = null;
    history = [];
    render();
  }

  function switchTurn() {
    state.turn = state.turn === 1 ? 2 : 1;
    bestAction = null;
    render();
  }

  function hasWall(r1, c1, r2, c2, hW = state.hWalls, vW = state.vWalls) {
    if (r1 === r2) {
      const minC = Math.min(c1, c2);
      if (minC >= 0 && minC < 8) {
        if (vW[r1][minC] || (r1 > 0 && vW[r1 - 1][minC])) return true;
      }
    } else if (c1 === c2) {
      const minR = Math.min(r1, r2);
      if (minR >= 0 && minR < 8) {
        if (hW[minR][c1] || (c1 > 0 && hW[minR][c1 - 1])) return true;
      }
    }
    return false;
  }

  function bfsPath(startR, startC, targetR, hW = state.hWalls, vW = state.vWalls) {
    let q = [{ r: startR, c: startC, path: [{ r: startR, c: startC }] }];
    let visited = Array(9).fill(0).map(() => Array(9).fill(false));
    visited[startR][startC] = true;

    while (q.length > 0) {
      let { r, c, path } = q.shift();
      if (r === targetR) return { dist: path.length - 1, path };
      const dirs = [[-1,0],[1,0],[0,-1],[0,1]];
      for (let [dr, dc] of dirs) {
        let nr = r + dr, nc = c + dc;
        if (nr >= 0 && nr < 9 && nc >= 0 && nc < 9 && !visited[nr][nc]) {
          if (!hasWall(r, c, nr, nc, hW, vW)) {
            visited[nr][nc] = true;
            q.push({ r: nr, c: nc, path: [...path, { r: nr, c: nc }] });
          }
        }
      }
    }
    return { dist: Infinity, path: [] };
  }
  function isValidWall(r, c, type, s = state) {
    if (r < 0 || r >= 8 || c < 0 || c >= 8) return false;
    if (s.hWalls[r][c] || s.vWalls[r][c]) return false;
    if (type === 'h' && (c > 0 && s.hWalls[r][c - 1] || c < 7 && s.hWalls[r][c + 1])) return false;
    if (type === 'v' && (r > 0 && s.vWalls[r - 1][c] || r < 7 && s.vWalls[r + 1][c])) return false;

    let hW = s.hWalls.map(row => [...row]);
    let vW = s.vWalls.map(row => [...row]);
    if (type === 'h') hW[r][c] = true; else vW[r][c] = true;

    return bfsPath(s.p1.r, s.p1.c, 0, hW, vW).dist !== Infinity &&
           bfsPath(s.p2.r, s.p2.c, 8, hW, vW).dist !== Infinity;
  }

  function getLegalPawnMoves(player, s = state) {
    const me = player === 1 ? s.p1 : s.p2;
    const opp = player === 1 ? s.p2 : s.p1;
    let moves = [];
    const dirs = [[-1,0],[1,0],[0,-1],[0,1]];

    for (let [dr, dc] of dirs) {
      let nr = me.r + dr, nc = me.c + dc;
      if (nr >= 0 && nr < 9 && nc >= 0 && nc < 9 && !hasWall(me.r, me.c, nr, nc, s.hWalls, s.vWalls)) {
        if (nr === opp.r && nc === opp.c) {
          let jnr = nr + dr, jnc = nc + dc;
          if (jnr >= 0 && jnr < 9 && jnc >= 0 && jnc < 9 && !hasWall(nr, nc, jnr, jnc, s.hWalls, s.vWalls)) {
            moves.push({ type: 'move', r: jnr, c: jnc });
          } else {
            const sideDirs = dr === 0 ? [[-1,0],[1,0]] : [[0,-1],[0,1]];
            for (let [sdr, sdc] of sideDirs) {
              let snr = nr + sdr, snc = nc + sdc;
              if (snr >= 0 && snr < 9 && snc >= 0 && snc < 9 && !hasWall(nr, nc, snr, snc, s.hWalls, s.vWalls)) {
                moves.push({ type: 'move', r: snr, c: snc });
              }
            }
          }
        } else {
          moves.push({ type: 'move', r: nr, c: nc });
        }
      }
    }
    return moves;
  }

  function getSmartWallCandidates(player, s) {
    const opp = player === 1 ? s.p2 : s.p1;
    const targetR = player === 1 ? 8 : 0;
    const baseOppDist = bfsPath(opp.r, opp.c, targetR, s.hWalls, s.vWalls).dist;
    const myDist = bfsPath(s.p1.r, s.p1.c, 0, s.hWalls, s.vWalls).dist;
    let candidates = [];

    for (let r = 0; r < 8; r++) {
      for (let c = 0; c < 8; c++) {
        if (isValidWall(r, c, 'h', s)) {
          s.hWalls[r][c] = true;
          let newOppDist = bfsPath(opp.r, opp.c, targetR, s.hWalls, s.vWalls).dist;
          let newMyDist = bfsPath(s.p1.r, s.p1.c, 0, s.hWalls, s.vWalls).dist;
          s.hWalls[r][c] = false;
          let oppGain = newOppDist - baseOppDist;
          let myLoss = newMyDist - myDist;
          if (oppGain > 0 && oppGain >= myLoss) {
            candidates.push({ type: 'hwall', r, c, gain: oppGain * 2 - myLoss });
          }
        }
        if (isValidWall(r, c, 'v', s)) {
          s.vWalls[r][c] = true;
          let newOppDist = bfsPath(opp.r, opp.c, targetR, s.hWalls, s.vWalls).dist;
          let newMyDist = bfsPath(s.p1.r, s.p1.c, 0, s.hWalls, s.vWalls).dist;
          s.vWalls[r][c] = false;
          let oppGain = newOppDist - baseOppDist;
          let myLoss = newMyDist - myDist;
          if (oppGain > 0 && oppGain >= myLoss) {
            candidates.push({ type: 'vwall', r, c, gain: oppGain * 2 - myLoss });
          }
        }
      }
    }
    candidates.sort((a, b) => b.gain - a.gain);
    return candidates.slice(0, 10);
  }

  function evaluateAdvanced(s) {
    let d1 = bfsPath(s.p1.r, s.p1.c, 0, s.hWalls, s.vWalls).dist;
    let d2 = bfsPath(s.p2.r, s.p2.c, 8, s.hWalls, s.vWalls).dist;
    if (d1 === 0) return 100000;
    if (d2 === 0) return -100000;
    if (d1 === Infinity) return -90000;
    if (d2 === Infinity) return 90000;

    let score = (d2 - d1) * 40;
    score += (s.p1.walls - s.p2.walls) * 6;
    score += (8 - s.p1.r) * 3 - s.p2.r * 3;
    score += (4 - Math.abs(4 - s.p1.c)) * 2 - (4 - Math.abs(4 - s.p2.c)) * 2;
    return score;
  }

  function minimax(s, depth, alpha, beta, isMax) {
    if (depth === 0 || s.p1.r === 0 || s.p2.r === 8) return evaluateAdvanced(s);
    let p = isMax ? 1 : 2;
    let moves = getLegalPawnMoves(p, s);
    if ((p === 1 ? s.p1.walls : s.p2.walls) > 0) {
      moves = moves.concat(getSmartWallCandidates(p, s));
    }

    if (isMax) {
      let maxEval = -Infinity;
      for (let m of moves) {
        let next = JSON.parse(JSON.stringify(s));
        if (m.type === 'move') { next.p1.r = m.r; next.p1.c = m.c; }
        else if (m.type === 'hwall') { next.hWalls[m.r][m.c] = true; next.p1.walls--; }
        else if (m.type === 'vwall') { next.vWalls[m.r][m.c] = true; next.p1.walls--; }

        let ev = minimax(next, depth - 1, alpha, beta, false);
        maxEval = Math.max(maxEval, ev);
        alpha = Math.max(alpha, ev);
        if (beta <= alpha) break;
      }
      return maxEval;
    } else {
      let minEval = Infinity;
      for (let m of moves) {
        let next = JSON.parse(JSON.stringify(s));
        if (m.type === 'move') { next.p2.r = m.r; next.p2.c = m.c; }
        else if (m.type === 'hwall') { next.hWalls[m.r][m.c] = true; next.p2.walls--; }
        else if (m.type === 'vwall') { next.vWalls[m.r][m.c] = true; next.p2.walls--; }

        let ev = minimax(next, depth - 1, alpha, beta, true);
        minEval = Math.min(minEval, ev);
        beta = Math.min(beta, ev);
        if (beta <= alpha) break;
      }
      return minEval;
    }
  }

  function calculateBestMove() {
    let p = state.turn;
    let isMax = (p === 1);
    let moves = getLegalPawnMoves(p, state);
    if ((p === 1 ? state.p1.walls : state.p2.walls) > 0) {
      moves = moves.concat(getSmartWallCandidates(p, state));
    }
    if (moves.length === 0) return;

    let bestScore = isMax ? -Infinity : Infinity;
    let best = moves[0];

    for (let m of moves) {
      let next = JSON.parse(JSON.stringify(state));
      if (m.type === 'move') {
        if (p === 1) { next.p1.r = m.r; next.p1.c = m.c; }
        else { next.p2.r = m.r; next.p2.c = m.c; }
      } else if (m.type === 'hwall') {
        next.hWalls[m.r][m.c] = true;
        if (p === 1) next.p1.walls--; else next.p2.walls--;
      } else if (m.type === 'vwall') {
        next.vWalls[m.r][m.c] = true;
        if (p === 1) next.p1.walls--; else next.p2.walls--;
      }

      let score = minimax(next, 3, -Infinity, Infinity, !isMax);
      if (isMax && score > bestScore) { bestScore = score; best = m; }
      if (!isMax && score < bestScore) { bestScore = score; best = m; }
    }

    bestAction = best;
    render();
  }

  function applyAction(action) {
    saveHistory();
    if (action.type === 'move') {
      if (state.turn === 1) { state.p1.r = action.r; state.p1.c = action.c; }
      else { state.p2.r = action.r; state.p2.c = action.c; }
    } else if (action.type === 'hwall') {
      state.hWalls[action.r][action.c] = true;
      if (state.turn === 1) state.p1.walls--; else state.p2.walls--;
    } else if (action.type === 'vwall') {
      state.vWalls[action.r][action.c] = true;
      if (state.turn === 1) state.p1.walls--; else state.p2.walls--;
    }
    bestAction = null;
    state.turn = state.turn === 1 ? 2 : 1;
    render();
  }

  function render() {
    const boardEl = document.getElementById('board');
    boardEl.innerHTML = '';
    document.getElementById('p1-walls').innerText = state.p1.walls;
    document.getElementById('p2-walls').innerText = state.p2.walls;
    const turnEl = document.getElementById('turn-indicator');
    turnEl.innerText = state.turn === 1 ? 'Ход: Вы' : 'Ход: Враг';
    turnEl.className = `turn-badge ${state.turn === 1 ? 'p1-turn' : 'p2-turn'}`;

    let d1 = bfsPath(state.p1.r, state.p1.c, 0).dist;
    let d2 = bfsPath(state.p2.r, state.p2.c, 8).dist;
    document.getElementById('eval-info').innerText = `Дистанция: Вы ${d1} | Враг ${d2}`;

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        let cell = document.createElement('div');
        cell.className = 'cell';
        if (state.p1.r === r && state.p1.c === c) {
          let p = document.createElement('div'); p.className = 'pawn p1-pawn'; cell.appendChild(p);
        } else if (state.p2.r === r && state.p2.c === c) {
          let p = document.createElement('div'); p.className = 'pawn p2-pawn'; cell.appendChild(p);
        }
        if (bestAction?.type === 'move' && bestAction.r === r && bestAction.c === c) {
          cell.classList.add('hint-move');
        }
        cell.onclick = () => { if (editMode === 'move') applyAction({ type: 'move', r, c }); };
        boardEl.appendChild(cell);

        if (c < 8) {
          let slotV = document.createElement('div');
          slotV.className = 'slot-v';
          let isPlaced = state.vWalls[r]?.[c] || (r > 0 && state.vWalls[r - 1]?.[c]);
          let isHint = (bestAction?.type === 'vwall' && (bestAction.r === r || bestAction.r === r - 1) && bestAction.c === c);
          if (isPlaced) slotV.classList.add('wall-active');
          if (isHint) slotV.classList.add('wall-hint');
          slotV.onclick = () => {
            if (editMode === 'vwall' && isValidWall(r < 8 ? r : r - 1, c, 'v')) {
              applyAction({ type: 'vwall', r: r < 8 ? r : r - 1, c });
            }
          };
          boardEl.appendChild(slotV);
        }
      }

      if (r < 8) {
        for (let c = 0; c < 9; c++) {
          let slotH = document.createElement('div');
          slotH.className = 'slot-h';
          let isPlaced = state.hWalls[r]?.[c] || (c > 0 && state.hWalls[r]?.[c - 1]);
          let isHint = (bestAction?.type === 'hwall' && bestAction.r === r && (bestAction.c === c || bestAction.c === c - 1));
          if (isPlaced) slotH.classList.add('wall-active');
          if (isHint) slotH.classList.add('wall-hint');
          slotH.onclick = () => {
            if (editMode === 'hwall' && isValidWall(r, c < 8 ? c : c - 1, 'h')) {
              applyAction({ type: 'hwall', r, c: c < 8 ? c : c - 1 });
            }
          };
          boardEl.appendChild(slotH);

          if (c < 8) {
            let dot = document.createElement('div');
            dot.className = 'slot-dot';
            boardEl.appendChild(dot);
          }
        }
      }
    }
  }

  render();
</script>
</body>
</html>
